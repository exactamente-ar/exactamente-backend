{
  "name": "exactamente-backend",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "//prepare": "`|| true` es obligatorio: bun install lo ejecuta también dentro del Dockerfile, donde no hay .git y lefthook falla. Sin eso se cae el build de producción.",
    "prepare": "lefthook install || true",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "seed:blogs": "bun scripts/seed-blogs.ts",
    "xlsx-to-ts": "bun scripts/xlsx-to-ts.ts",
    "migrate-drive": "bun scripts/migrate-drive-to-r2.ts",
    "gen:openapi": "bun scripts/gen-openapi.ts",
    "check:openapi": "bun scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@hono/standard-validator": "^0.3.0",
    "@hono/zod-validator": "^0.4.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "drizzle-orm": "^0.38.0",
    "googleapis": "^171.4.0",
    "hono": "^4.6.0",
    "hono-openapi": "^1.3.1",
    "pg": "^8.23.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0",
    "xlsx": "^0.18.5"
  }
}
