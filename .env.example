# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exactamente

# Auth
JWT_SECRET=super-secret-key-minimo-32-characters-long

# Servidor
PORT=3000
NODE_ENV=development

# CORS — frontend principal
CORS_ORIGIN=http://localhost:4321

# CORS — admin frontend
ADMIN_ORIGIN=http://localhost:5173

# Seed (solo necesario al correr `bun seed`, mínimo 12 caracteres)
SEED_ADMIN_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# En producción: https://api.exactamente.com.ar/api/v1/auth/google/callback

# Cloudflare R2 — solo necesarias con STORAGE_PROVIDER=r2 (default)
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=r2  # producción: descomentá y completá las R2_*
# Ruta local para archivos cuando STORAGE_PROVIDER=local
STORAGE_PATH=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exactamente
R2_PUBLIC_URL=https://files.exactamente.ar
