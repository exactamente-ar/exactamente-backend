# Copiá este archivo a `.env` (el setup.sh del workspace ya lo hace) y listo:
# con estos valores el backend arranca en local sin pedirte ninguna credencial.
#
# Lo que NO va a andar hasta que pongas credenciales reales está marcado abajo
# con "⚠️ sin credenciales". Todo lo demás funciona.

# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exactamente

# Auth
JWT_SECRET=super-secret-key-minimo-32-characters-long

# Servidor
PORT=3000
NODE_ENV=development

# CORS — frontend principal
CORS_ORIGIN=http://localhost:4321

# CORS — admin frontend
ADMIN_ORIGIN=http://localhost:5173

# Seed — contraseña del admin que crea `bun seed`, mínimo 12 caracteres.
# Con este valor entrás al panel en localhost:5173. Cambiala si querés.
SEED_ADMIN_PASSWORD=dev-admin-local-1234

# Google OAuth — ⚠️ sin credenciales reales: "Entrar con Google" falla.
# El login con email y contraseña anda igual, así que para desarrollar alcanza.
GOOGLE_CLIENT_ID=dev-sin-google-oauth
GOOGLE_CLIENT_SECRET=dev-sin-google-oauth
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# En producción: https://api.exactamente.com.ar/api/v1/auth/google/callback

# Cloudflare R2 — ⚠️ sin credenciales reales: subir archivos falla.
# Listar, buscar y moderar recursos anda; lo único que rompe es el upload.
# Los placeholders son a propósito: `src/env.ts` las exige y el proceso no
# arranca sin ellas, pero nadie necesita las de producción para desarrollar.
# Pedilas solo si vas a tocar el flujo de subida.
R2_ACCOUNT_ID=dev-sin-r2
R2_ACCESS_KEY_ID=dev-sin-r2
R2_SECRET_ACCESS_KEY=dev-sin-r2
R2_BUCKET_NAME=exactamente
R2_PUBLIC_URL=https://files.exactamente.com.ar

# Email (Resend) — ⚠️ sin credenciales reales: no se manda ningún mail.
RESEND_API_KEY=re_xxxxxxxxxxxx
APP_URL=http://localhost:4321
